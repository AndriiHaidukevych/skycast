# OpenWeather API — get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here
# Public key for map tiles (same value as OPENWEATHER_API_KEY)
NEXT_PUBLIC_OPENWEATHER_API_KEY=your_api_key_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/skycast

# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
